      "input": {"workorder": {"id": 105, "quantity": "30", "quantityProduced": "25", "unit": "件", "status": "CONFIRMED"}, "tasks": [{"id": 51, "process_id": 5, "quantity": "30", "quantityProduced": "25", "unit": "件"}], "feedback_batches": [{"id_start": 100, "count": 20, "task_id": 51, "process_id": 5, "quantityFeedback": "1", "status": "FINISHED", "page": 1}, {"id_start": 120, "count": 5, "task_id": 51, "process_id": 5, "quantityFeedback": "1", "status": "FINISHED", "page": 2}], "feedback_total": 25, "pages_complete": true},
      "expected": {"available": true, "workorder_produced_fact": "25", "remaining_raw": "5", "ratio_percent": "83.333333333333333333", "process_finished_sums": {"5": "25"}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": [100, 124]}
