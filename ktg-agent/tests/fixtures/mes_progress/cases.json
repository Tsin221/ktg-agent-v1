      "input": {"workorder": {"id": 108, "quantity": "10", "quantityProduced": "12", "unit": "件", "status": "CONFIRMED"}, "tasks": [], "feedback": []},
      "expected": {"available": true, "workorder_produced_fact": "12", "remaining_raw": "-2", "ratio_percent": "120", "process_finished_sums": {}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": []}
    },
    {
