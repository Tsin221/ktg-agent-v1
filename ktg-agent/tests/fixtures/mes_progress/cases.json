      "expected": {"available": true, "workorder_produced_fact": "0", "remaining_raw": "0", "ratio_percent": null, "ratio_reason": "ZERO_DENOMINATOR", "process_finished_sums": {}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": []}
