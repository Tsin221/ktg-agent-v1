      "input": {"workorder": {"id": 101, "quantity": "10", "quantityProduced": "4", "unit": "件", "status": "CONFIRMED"}, "tasks": [{"id": 11, "process_id": 1, "quantity": "10", "quantityProduced": "4", "unit": "件"}, {"id": 12, "process_id": 2, "quantity": "10", "quantityProduced": "4", "unit": "件"}], "feedback": [{"id": 1, "task_id": 11, "process_id": 1, "quantityFeedback": "4", "status": "FINISHED"}, {"id": 2, "task_id": 12, "process_id": 2, "quantityFeedback": "4", "status": "FINISHED"}]},
      "expected": {"available": true, "workorder_produced_fact": "4", "remaining_raw": "6", "ratio_percent": "40", "process_finished_sums": {"1": "4", "2": "4"}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": [1, 2]}
    },
    {
      "case_id": "fractional_remaining", "split": "dev", "scenario": "小数计划量与剩余量",
      "input": {"workorder": {"id": 102, "quantity": "8.5", "quantityProduced": "5", "unit": "kg", "status": "CONFIRMED"}, "tasks": [], "feedback": []},
      "expected": {"available": true, "workorder_produced_fact": "5", "remaining_raw": "3.5", "ratio_percent": "58.823529411764705882", "process_finished_sums": {}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": []}
    },
    {
