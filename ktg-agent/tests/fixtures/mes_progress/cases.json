      "input": {"workorder": {"id": 110, "quantity": "10", "quantityProduced": "2", "unit": "件", "status": "CONFIRMED"}, "tasks": [], "feedback": [], "permissions": {"workorder_query": true, "task_list": true, "feedback_list": false}},
      "expected": {"available": false, "unavailable_reason": "PERMISSION_DENIED", "workorder_produced_fact": null, "remaining_raw": null, "ratio_percent": null, "process_finished_sums": null, "process_metric": null, "trace_ids": []}
    },
    {
      "case_id": "concurrent_change", "split": "holdout", "scenario": "多次 HTTP 读取间工单版本变化",
      "input": {"workorder": {"id": 111, "quantity": "10", "quantityProduced": "4", "unit": "件", "status": "CONFIRMED", "version": 1}, "tasks": [{"id": 111, "process_id": 1, "quantity": "10", "quantityProduced": "5", "unit": "件"}], "feedback": [{"id": 111, "task_id": 111, "process_id": 1, "quantityFeedback": "5", "status": "FINISHED"}], "workorder_produced_after_reads": "5", "workorder_version_after_reads": 1},
      "expected": {"available": false, "unavailable_reason": "INCONSISTENT_OBSERVATION", "workorder_produced_fact": null, "remaining_raw": null, "ratio_percent": null, "process_finished_sums": null, "process_metric": null, "trace_ids": []}
    },
    {
      "case_id": "partial_read_failure", "split": "holdout", "scenario": "报工第二页读取失败",
      "input": {"workorder": {"id": 112, "quantity": "30", "quantityProduced": "20", "unit": "件", "status": "CONFIRMED"}, "tasks": [], "feedback_batches": [{"id_start": 200, "count": 20, "task_id": 0, "process_id": 1, "quantityFeedback": "1", "status": "FINISHED", "page": 1}], "feedback_total": 30, "pages_complete": false, "read_error": "MES_TIMEOUT"},
      "expected": {"available": false, "unavailable_reason": "SOURCE_INCOMPLETE", "workorder_produced_fact": null, "remaining_raw": null, "ratio_percent": null, "process_finished_sums": null, "process_metric": null, "trace_ids": []}
    },
    {
      "case_id": "unit_mismatch", "split": "holdout", "scenario": "任务单位与工单单位不一致，不换算",
      "input": {"workorder": {"id": 113, "quantity": "10", "quantityProduced": "4", "unit": "件", "status": "CONFIRMED"}, "tasks": [{"id": 131, "process_id": 1, "quantity": "10", "quantityProduced": "4", "unit": "kg"}], "feedback": [{"id": 131, "task_id": 131, "process_id": 1, "quantityFeedback": "4", "status": "FINISHED"}]},
      "expected": {"available": true, "workorder_produced_fact": "4", "remaining_raw": "6", "ratio_percent": "40", "process_finished_sums": {"1": "4"}, "process_metric": null, "process_reason": "UNIT_MISMATCH", "trace_ids": [131]}
