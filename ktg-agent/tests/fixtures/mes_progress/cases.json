      "input": {"workorder": {"id": 104, "quantity": "20", "quantityProduced": "7", "unit": "件", "status": "CONFIRMED"}, "tasks": [{"id": 41, "process_id": 5, "quantity": "20", "quantityProduced": "7", "unit": "件"}], "feedback": [{"id": 41, "task_id": 41, "process_id": 5, "quantityFeedback": "3", "status": "FINISHED"}, {"id": 42, "task_id": 41, "process_id": 5, "quantityFeedback": "4", "status": "FINISHED"}]},
      "expected": {"available": true, "workorder_produced_fact": "7", "remaining_raw": "13", "ratio_percent": "35", "process_finished_sums": {"5": "7"}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": [41, 42]}
    },
