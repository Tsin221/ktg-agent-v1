{
  "schema_version": "mes-07-fixture-v1",
  "synthetic": true,
  "notes": "所有数量为十进制字符串；feedback_batches 按 id_start 起连续 count 条展开；process_finished_sums 仅为评测校验值，不是获批业务指标。",
  "cases": [
