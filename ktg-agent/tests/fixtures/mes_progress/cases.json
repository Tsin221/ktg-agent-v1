      "input": {"workorder": {"id": 103, "quantity": "10", "quantityProduced": "0", "unit": "件", "status": "CONFIRMED"}, "tasks": [{"id": 31, "process_id": 1, "quantity": "10", "quantityProduced": "10", "unit": "件"}, {"id": 32, "process_id": 2, "quantity": "10", "quantityProduced": null, "unit": "件"}], "feedback": [{"id": 31, "task_id": 31, "process_id": 1, "quantityFeedback": "10", "status": "FINISHED"}]},
      "expected": {"available": true, "workorder_produced_fact": "0", "remaining_raw": "10", "ratio_percent": "0", "process_finished_sums": {"1": "10", "2": "0"}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": [31]}
