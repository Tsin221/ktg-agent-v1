      "input": {"workorder": {"id": 109, "quantity": "10", "quantityProduced": null, "unit": "件", "status": "CONFIRMED"}, "tasks": [], "feedback": []},
      "expected": {"available": true, "workorder_produced_fact": null, "remaining_raw": null, "remaining_reason": "MISSING_PRODUCED", "ratio_percent": null, "ratio_reason": "MISSING_PRODUCED", "process_finished_sums": {}, "process_metric": null, "process_reason": "BUSINESS_RULE_UNCONFIRMED", "trace_ids": []}
