# Copy this file to .env and replace every CHANGE_ME value.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=j2eedb
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_APP_USER=ktg_app
MYSQL_APP_PASSWORD=CHANGE_ME

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

APP_TOKEN_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DRUID_ADMIN_USERNAME=ktg_druid_admin
DRUID_ADMIN_PASSWORD=CHANGE_ME

MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=ktg-mes

KTG_UPLOAD_DIR=E:/ktg_agent/ktg_agent_v1/upload
KTG_LOG_DIR=E:/ktg_agent/ktg_agent_v1/logs

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_AFTER_FIRST_LOGIN

# KTG Agent (OpenAI-compatible chat completions)
MODEL_API_KEY=CHANGE_ME
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_ID=CHANGE_ME
KTG_BASE_URL=http://127.0.0.1:8080
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
# Device ledger write previews are disabled until explicitly enabled.
# When enabled, preview state is stored in a separate SQLite file.
# AGENT_ENABLE_DV_MACHINERY_WRITE=true
# AGENT_DV_MACHINERY_DB=E:/ktg_agent/ktg_agent_v1/.runtime/agent-dv-machinery.sqlite3
# Point inspection/maintenance subject writes are disabled by default.
# AGENT_ENABLE_DV_SUBJECT_WRITE=true
# AGENT_DV_SUBJECT_DB=E:/ktg_agent/ktg_agent_v1/.runtime/agent-dv-subject.sqlite3
# T05 plan preview/confirmation writes stay disabled until explicitly enabled.
# When enabling, set a separate absolute SQLite path, distinct from session and other proposal databases.
AGENT_ENABLE_DV_CHECKPLAN_WRITE=false
# AGENT_DV_CHECKPLAN_DB=E:/ktg_agent/ktg_agent_v1/.runtime/agent-dv-checkplan.sqlite3
# Optional positive run token threshold; not a strict billing cap.
# AGENT_MAX_TOTAL_TOKENS=5000
